#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WORKSPACE_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
MANIFEST="$WORKSPACE_ROOT/harness/repos.json"
RUNS_ROOT="${HARNESS_RUNS_ROOT:-$WORKSPACE_ROOT/harness/runs}"
# shellcheck source=../lib/repository-state.sh
source "$WORKSPACE_ROOT/harness/lib/repository-state.sh"
# shellcheck source=../lib/workflow.sh
source "$WORKSPACE_ROOT/harness/lib/workflow.sh"
issue_id="${1:-}"
owner="${2:-}"
worktree="${3:-}"

if [[ ! "$issue_id" =~ ^[A-Z][A-Z0-9]+-[0-9]+$ || -z "$owner" || -z "$worktree" ]]; then
  printf 'usage: %s <ISSUE-ID> <owner> <worktree>\n' "$0" >&2
  exit 2
fi

run_dir="$RUNS_ROOT/$issue_id"
claim_dir="$run_dir/.claim"
if [[ ! -f "$run_dir/task.json" ]]; then
  printf 'claim-ticket: start the ticket first: %s\n' "$issue_id" >&2
  exit 1
fi

"$SCRIPT_DIR/validate-run" "$issue_id" >/dev/null

jq -e '.acceptance_criteria | length > 0' "$run_dir/task.json" >/dev/null || {
  printf 'claim-ticket: requires acceptance criteria\n' >&2
  exit 1
}
phase="$(jq -r '.phase' "$run_dir/workflow.json")"
case "$phase" in
  planned) action=claim_implementation ;;
  repair) action=claim_repair ;;
  awaiting_review) action=claim_review ;;
  human_blocked) printf 'claim-ticket: human_blocked requires a follow-up Linear decision\n' >&2; exit 1 ;;
  *) printf 'claim-ticket: phase is not claimable: %s\n' "$phase" >&2; exit 1 ;;
esac

repository="$(jq -r '.repositories[0]' "$run_dir/task.json")"
resolved_worktree="$(validate_claimed_repository "$repository" "$worktree" "$issue_id")" || {
  printf 'claim-ticket: worktree does not match the task repository or branch contract\n' >&2
  exit 1
}

# mkdir is the cross-agent atomic ownership operation.
if ! mkdir "$claim_dir" 2>/dev/null; then
  printf 'claim-ticket: ticket already claimed: %s\n' "$issue_id" >&2
  if [[ -f "$claim_dir/owner.json" ]]; then
    jq '{owner, worktree, claimed_at}' "$claim_dir/owner.json" >&2
  fi
  exit 1
fi

claimed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
jq -n \
  --arg owner "$owner" \
  --arg worktree "$resolved_worktree" \
  --arg claimed_at "$claimed_at" \
  '{owner: $owner, worktree: $worktree, claimed_at: $claimed_at}' \
  > "$claim_dir/owner.json"

if [[ "$phase" == awaiting_review ]]; then
  jq -n --arg issue_id "$issue_id" --arg repository "$repository" \
    '{issue_id:$issue_id,repository:$repository,verdict:"pending",findings:[]}' > "$run_dir/review.json.tmp"
  mv "$run_dir/review.json.tmp" "$run_dir/review.json"
  next_phase=reviewing
else
  next_phase=implementing
fi
if ! workflow_transition "$run_dir" "$phase" "$next_phase" "$owner" "$action"; then
  rm -rf "$claim_dir"
  exit 1
fi

printf '# Current\n\n- Owner: %s\n- Worktree: %s\n- Phase: %s\n- Next action: %s\n- Blockers: none recorded\n' \
  "$owner" "$resolved_worktree" "$next_phase" "$(workflow_next_action "$next_phase")" > "$run_dir/current.md"
printf 'claim-ticket: %s claimed by %s in %s; phase=%s\n' "$issue_id" "$owner" "$resolved_worktree" "$next_phase"
