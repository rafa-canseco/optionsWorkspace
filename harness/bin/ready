#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WORKSPACE_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
MANIFEST="$WORKSPACE_ROOT/harness/repos.json"
RUNS_ROOT="${HARNESS_RUNS_ROOT:-$WORKSPACE_ROOT/harness/runs}"
# shellcheck source=../lib/dependencies.sh
source "$WORKSPACE_ROOT/harness/lib/dependencies.sh"

shopt -s nullglob
for task_file in "$RUNS_ROOT"/*/task.json; do
  run_dir="$(dirname -- "$task_file")"
  issue_id="$(basename -- "$run_dir")"
  if ! "$SCRIPT_DIR/validate-run" "$issue_id" >/dev/null 2>&1; then
    printf '%s blocked invalid_run\n' "$issue_id"
    continue
  fi
  if [[ -d "$run_dir/.claim" ]]; then
    printf '%s blocked claimed\n' "$issue_id"
    continue
  fi
  phase="$(jq -r '.phase // empty' "$run_dir/workflow.json" 2>/dev/null)" || phase=''
  case "$phase" in
    planned|repair|awaiting_review)
      if ! reason="$(dependencies_check "$run_dir")"; then
        reason="${reason//$'\n'/; }"
        printf '%s blocked %s\n' "$issue_id" "$reason"
      elif [[ "$phase" == awaiting_review ]]; then
        printf '%s ready review\n' "$issue_id"
      else
        printf '%s ready %s\n' "$issue_id" "$( [[ "$phase" == repair ]] && printf 'repair' || printf 'implementation' )"
      fi
      ;;
    *) printf '%s blocked phase=%s\n' "$issue_id" "${phase:-invalid}" ;;
  esac
done
