#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WORKSPACE_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
MANIFEST="$WORKSPACE_ROOT/harness/repos.json"
RUNS_ROOT="${HARNESS_RUNS_ROOT:-$WORKSPACE_ROOT/harness/runs}"
# shellcheck source=../lib/repository-state.sh
source "$WORKSPACE_ROOT/harness/lib/repository-state.sh"

if (( $# == 0 )); then
  printf 'usage: %s <ISSUE-ID> [ISSUE-ID ...]\n' "$0" >&2
  exit 2
fi

caller_worktree="$(pwd -P)"
for issue_id in "$@"; do
  [[ "$issue_id" =~ ^[A-Z][A-Z0-9]+-[0-9]+$ ]] || {
    printf 'migrate-run-statuses: invalid issue id: %s\n' "$issue_id" >&2
    exit 2
  }
done

for issue_id in "$@"; do
  run_dir="$RUNS_ROOT/$issue_id"
  task_file="$run_dir/task.json"
  claim_file="$run_dir/.claim/owner.json"
  [[ -f "$task_file" ]] || { printf 'migrate-run-statuses: missing task: %s\n' "$issue_id" >&2; exit 1; }
  jq empty "$task_file" >/dev/null 2>&1 || { printf 'migrate-run-statuses: malformed task: %s\n' "$issue_id" >&2; exit 1; }
  [[ ! -f "$run_dir/workflow.json" ]] || { printf 'migrate-run-statuses: %s is workflow-managed; no migration needed\n' "$issue_id" >&2; exit 1; }

  if [[ -f "$claim_file" ]]; then
    repository="$(jq -r '.repositories[0]' "$task_file")"
    claim_worktree="$(jq -r '.worktree // empty' "$claim_file")"
    claim_worktree="$(CDPATH= cd -- "$claim_worktree" 2>/dev/null && pwd -P)" || { printf 'migrate-run-statuses: invalid claim: %s\n' "$issue_id" >&2; exit 1; }
    [[ "$claim_worktree" == "$caller_worktree" ]] || { printf 'migrate-run-statuses: %s is claimed by another caller worktree\n' "$issue_id" >&2; exit 1; }
    validate_claimed_repository "$repository" "$claim_worktree" "$issue_id" >/dev/null || exit 1
  fi

  [[ "$(jq -r '.status // empty' "$task_file" 2>/dev/null)" == implementing ]] || {
    printf 'migrate-run-statuses: %s is not implementing; skipped\n' "$issue_id"
    continue
  }
  task_tmp="$(mktemp "$run_dir/.task.json.migrate.XXXXXX")"
  trap 'rm -f "$task_tmp"' EXIT
  jq '.status = "in_progress"' "$task_file" > "$task_tmp"
  jq -e --arg issue_id "$issue_id" '
    def timestamp: type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$");
    ((keys - ["issue_id", "objective", "acceptance_criteria", "repositories", "dependencies", "status", "created_at"]) | length == 0) and
    .issue_id == $issue_id and (.objective | type == "string" and length > 0) and
    (.acceptance_criteria | type == "array" and all(.[]; type == "string" and length > 0)) and
    (.repositories | type == "array" and length == 1) and
    (.repositories[0] | IN("workspace", "frontend", "backend", "blockchain", "marketMaker")) and
    (.dependencies | type == "array" and (map([.issue_id,.gate]) | unique | length) == length and all(.[ ];
      type == "object" and ((keys - ["issue_id", "gate"]) | length == 0) and
      (.issue_id | type == "string" and test("^[A-Z][A-Z0-9]+-[0-9]+$") and . != $issue_id) and
      (.gate | IN("contract_approved", "fixture_pinned", "pr_ready", "merged")))) and
    (.created_at | timestamp) and .status == "in_progress"
  ' "$task_tmp" >/dev/null || { printf 'migrate-run-statuses: %s would produce an invalid task packet; unchanged\n' "$issue_id" >&2; exit 1; }
  mv "$task_tmp" "$task_file"
  trap - EXIT
  printf 'migrate-run-statuses: %s -> in_progress\n' "$issue_id"
done
