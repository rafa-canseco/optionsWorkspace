#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WORKSPACE_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
MANIFEST="$WORKSPACE_ROOT/harness/repos.json"
RUNS_ROOT="${HARNESS_RUNS_ROOT:-$WORKSPACE_ROOT/harness/runs}"
# shellcheck source=../lib/repository-state.sh
source "$WORKSPACE_ROOT/harness/lib/repository-state.sh"
repository="${1:-}"
tier="${2:-fast}"
record_issue=""

usage() {
  printf 'usage: %s <workspace|frontend|backend|blockchain|marketMaker|all> [fast|full] [--record ISSUE-ID]\n' "$0" >&2
}

if [[ -z "$repository" || ( "$tier" != "fast" && "$tier" != "full" ) ]]; then
  usage
  exit 2
fi
if (( $# == 4 )) && [[ "$3" == "--record" && "$4" =~ ^[A-Z][A-Z0-9]+-[0-9]+$ ]]; then
  record_issue="$4"
elif (( $# > 2 )); then
  usage
  exit 2
fi
if [[ "$repository" == "all" && -n "$record_issue" ]]; then
  printf 'check: recording requires one repository\n' >&2
  exit 2
fi

repository_command=()
repository_path=""
load_target() {
  local target="$1"
  local command_argument

  if ! jq -e --arg target "$target" '.repositories[$target] != null' "$MANIFEST" >/dev/null; then
    printf 'check: unknown repository: %s\n' "$target" >&2
    return 2
  fi

  repository_path="$(jq -r --arg target "$target" '.repositories[$target].path' "$MANIFEST")"
  repository_command=()
  while IFS= read -r command_argument; do
    repository_command+=("$command_argument")
  done < <(jq -r --arg target "$target" --arg tier "$tier" '.repositories[$target].checks[$tier][]' "$MANIFEST")

  if (( ${#repository_command[@]} == 0 )); then
    printf 'check: no command configured for repository=%s tier=%s\n' "$target" "$tier" >&2
    return 2
  fi
}

run_one() {
  local target="$1"
  load_target "$target" || return
  printf '\ncheck: repository=%s tier=%s\n' "$target" "$tier"
  (cd "$WORKSPACE_ROOT/$repository_path" && "${repository_command[@]}")
}

claimed_worktree() {
  local owner_file="$RUNS_ROOT/$record_issue/.claim/owner.json"
  local worktree_input
  if [[ ! -f "$owner_file" ]]; then
    printf 'check: recording requires an active claim for %s\n' "$record_issue" >&2
    return 1
  fi
  worktree_input="$(jq -r '.worktree // empty' "$owner_file")"
  if [[ -z "$worktree_input" ]]; then
    printf 'check: claim has no worktree for %s\n' "$record_issue" >&2
    return 1
  fi
  validate_claimed_repository "$repository" "$worktree_input" "$record_issue"
}

CONTROL_COMMIT_SHA=""
CONTROL_MANIFEST_BLOB_SHA=""
load_control_identity() {
  local repository_name="$1"
  local worktree="$2"
  local identity
  identity="$(control_plane_identity "$repository_name" "$worktree")" || return 1
  if [[ "$identity" != *$'\n'* ]]; then
    return 1
  fi
  CONTROL_COMMIT_SHA="${identity%%$'\n'*}"
  CONTROL_MANIFEST_BLOB_SHA="${identity#*$'\n'}"
  [[ -n "$CONTROL_COMMIT_SHA" && -n "$CONTROL_MANIFEST_BLOB_SHA" && "$CONTROL_MANIFEST_BLOB_SHA" != *$'\n'* ]]
}

write_evidence() {
  local commit_sha="$1"
  local control_commit_sha="$2"
  local manifest_blob_sha="$3"
  local started_at="$4"
  local ended_at="$5"
  local duration_seconds="$6"
  local exit_code="$7"
  local command_name="$8"
  shift 8
  local status="passed"
  local command_arguments_json
  local evidence_tmp="$RUNS_ROOT/$record_issue/verification.json.tmp"

  if (( exit_code != 0 )); then
    status="failed"
  fi
  command_arguments_json="$(jq -cn --args '$ARGS.positional' "$@")"
  jq -n \
    --arg issue_id "$record_issue" \
    --arg repository "$repository" \
    --arg tier "$tier" \
    --arg commit_sha "$commit_sha" \
    --arg control_commit_sha "$control_commit_sha" \
    --arg manifest_blob_sha "$manifest_blob_sha" \
    --arg started_at "$started_at" \
    --arg ended_at "$ended_at" \
    --arg status "$status" \
    --arg command "$command_name" \
    --argjson arguments "$command_arguments_json" \
    --argjson duration_seconds "$duration_seconds" \
    --argjson exit_code "$exit_code" \
    '{
      issue_id: $issue_id,
      repository: $repository,
      tier: $tier,
      commit_sha: $commit_sha,
      started_at: $started_at,
      ended_at: $ended_at,
      duration_seconds: $duration_seconds,
      control_plane: {
        commit_sha: $control_commit_sha,
        manifest_blob_sha: $manifest_blob_sha
      },
      check_command: {
        command: "harness/bin/check",
        arguments: [$repository, $tier, "--record", $issue_id]
      },
      overall: $status,
      commands: [{
        command: $command,
        arguments: $arguments,
        started_at: $started_at,
        ended_at: $ended_at,
        duration_seconds: $duration_seconds,
        commit_sha: $commit_sha,
        exit_code: $exit_code,
        status: $status
      }]
    }' > "$evidence_tmp"
  mv "$evidence_tmp" "$RUNS_ROOT/$record_issue/verification.json"
  printf 'check: recorded %s evidence for %s at %s\n' "$status" "$record_issue" "$commit_sha"
}

run_recorded() {
  local worktree task_repository commit_sha head_after
  local started_at ended_at started_epoch ended_epoch
  local command_exit final_exit=0
  local control_commit_before control_manifest_before control_commit_after control_manifest_after

  if [[ ! -f "$RUNS_ROOT/$record_issue/task.json" ]]; then
    printf 'check: unknown run: %s\n' "$record_issue" >&2
    return 1
  fi
  task_repository="$(jq -r '.repositories[0] // empty' "$RUNS_ROOT/$record_issue/task.json")"
  if [[ "$task_repository" != "$repository" ]]; then
    printf 'check: repository does not match task: expected=%s actual=%s\n' "$task_repository" "$repository" >&2
    return 1
  fi
  worktree="$(claimed_worktree)" || return
  require_clean_commit "$worktree" || {
    printf 'check: recording requires a clean claimed commit\n' >&2
    return 1
  }
  if ! load_control_identity "$repository" "$worktree"; then
    printf 'check: harness control plane is not commit-bound\n' >&2
    return 1
  fi
  control_commit_before="$CONTROL_COMMIT_SHA"
  control_manifest_before="$CONTROL_MANIFEST_BLOB_SHA"
  commit_sha="$(git -C "$worktree" rev-parse HEAD)"
  load_target "$repository" || return

  started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  started_epoch="$(date +%s)"
  printf '\ncheck: repository=%s tier=%s record=%s commit=%s\n' "$repository" "$tier" "$record_issue" "$commit_sha"
  set +e
  (cd "$worktree" && "${repository_command[@]}")
  command_exit=$?
  set -e
  final_exit="$command_exit"

  # The command cannot verify one tree and leave evidence for another. Re-check
  # repository identity, index flags, cleanliness, and HEAD after it returns.
  if ! validate_claimed_repository "$repository" "$worktree" "$record_issue" >/dev/null ||
     ! require_clean_commit "$worktree"; then
    printf 'check: canonical command changed or invalidated the claimed worktree\n' >&2
    final_exit=70
  else
    head_after="$(git -C "$worktree" rev-parse HEAD)"
    if load_control_identity "$repository" "$worktree"; then
      control_commit_after="$CONTROL_COMMIT_SHA"
      control_manifest_after="$CONTROL_MANIFEST_BLOB_SHA"
    else
      control_commit_after=""
      control_manifest_after=""
    fi
    if [[ "$head_after" != "$commit_sha" ]]; then
      printf 'check: canonical command changed HEAD during verification\n' >&2
      final_exit=70
    elif [[ "$control_commit_after" != "$control_commit_before" || "$control_manifest_after" != "$control_manifest_before" ]]; then
      printf 'check: canonical command changed the harness control plane\n' >&2
      final_exit=70
    fi
  fi

  ended_epoch="$(date +%s)"
  ended_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  write_evidence "$commit_sha" "$control_commit_before" "$control_manifest_before" \
    "$started_at" "$ended_at" "$((ended_epoch - started_epoch))" \
    "$final_exit" "${repository_command[0]}" "${repository_command[@]:1}"
  return "$final_exit"
}

if [[ -n "$record_issue" ]]; then
  worktree="$(claimed_worktree)" || exit
  require_clean_commit "$worktree" || exit
  if ! load_control_identity "$repository" "$worktree"; then
    printf 'check: harness control plane is not commit-bound\n' >&2
    exit 1
  fi
  control_commit_sha="$CONTROL_COMMIT_SHA"
  control_manifest_blob_sha="$CONTROL_MANIFEST_BLOB_SHA"
  commit_sha="$(git -C "$worktree" rev-parse HEAD)"
  started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  started_epoch="$(date +%s)"
  set +e
  (cd "$worktree" && "$SCRIPT_DIR/sensitive-check")
  sensitive_exit=$?
  set -e
  if (( sensitive_exit != 0 )); then
    ended_epoch="$(date +%s)"
    ended_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    write_evidence "$commit_sha" "$control_commit_sha" "$control_manifest_blob_sha" \
      "$started_at" "$ended_at" "$((ended_epoch - started_epoch))" \
      "$sensitive_exit" "harness/bin/sensitive-check"
    exit "$sensitive_exit"
  fi
  run_recorded
  exit
fi

"$SCRIPT_DIR/sensitive-check"

if [[ "$repository" != "all" ]]; then
  run_one "$repository"
  exit
fi

failed=0
for target in workspace frontend backend blockchain marketMaker; do
  if ! run_one "$target"; then
    failed=1
  fi
done

if (( failed != 0 )); then
  printf 'check: one or more repositories failed\n' >&2
  exit 1
fi
