#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WORKSPACE_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
MANIFEST="$WORKSPACE_ROOT/harness/repos.json"
RUNS_ROOT="${HARNESS_RUNS_ROOT:-$WORKSPACE_ROOT/harness/runs}"
# shellcheck source=../lib/repository-state.sh
source "$WORKSPACE_ROOT/harness/lib/repository-state.sh"
# shellcheck source=../lib/workflow.sh
source "$WORKSPACE_ROOT/harness/lib/workflow.sh"
# shellcheck source=../lib/dependencies.sh
source "$WORKSPACE_ROOT/harness/lib/dependencies.sh"
issue_id="${1:-}"
next_status="${2:-review}"

if [[ ! "$issue_id" =~ ^[A-Z][A-Z0-9]+-[0-9]+$ ]]; then
  printf 'usage: %s <ISSUE-ID> [planned|review|blocked|done]\n' "$0" >&2
  exit 2
fi
case "$next_status" in
  planned|review|blocked|done) ;;
  *)
    printf 'release-ticket: invalid next status: %s\n' "$next_status" >&2
    exit 2
    ;;
esac

run_dir="$RUNS_ROOT/$issue_id"
claim_dir="$run_dir/.claim"
if [[ ! -f "$claim_dir/owner.json" || ! -f "$run_dir/task.json" ]]; then
  printf 'release-ticket: active claim and task required for %s\n' "$issue_id" >&2
  exit 1
fi
repository="$(jq -r '.repositories[0] // empty' "$run_dir/task.json")"
if ! jq -e --arg issue_id "$issue_id" --arg repository "$repository" '
  .issue_id == $issue_id and .repositories == [$repository]
' "$run_dir/task.json" >/dev/null ||
   ! jq -e --arg repository "$repository" '.repositories[$repository] != null' "$MANIFEST" >/dev/null; then
  printf 'release-ticket: invalid task repository identity\n' >&2
  exit 1
fi

phase="$(jq -r '.phase // empty' "$run_dir/workflow.json")"
case "$next_status:$phase" in
  review:candidate|planned:reviewing|blocked:reviewing|done:reviewing) ;;
  *) printf 'release-ticket: invalid lifecycle transition: phase=%s status=%s\n' "$phase" "$next_status" >&2; exit 1 ;;
esac
if ! blockers="$(dependencies_check "$run_dir")"; then
  blockers="${blockers//$'\n'/; }"
  printf 'release-ticket: unsatisfied dependency: %s\n' "$blockers" >&2
  exit 1
fi

# A mutable JSON assertion is never the release authority. Re-run the canonical
# full check at the claimed commit and atomically replace verification evidence.
if [[ "$next_status" == "review" || "$next_status" == "done" ]]; then
  if ! "$SCRIPT_DIR/check" "$repository" full --record "$issue_id"; then
    printf 'release-ticket: canonical full verification failed; transition blocked\n' >&2
    exit 1
  fi
fi
if ! blockers="$(dependencies_check "$run_dir")"; then
  blockers="${blockers//$'\n'/; }"
  printf 'release-ticket: dependency became stale during verification: %s\n' "$blockers" >&2
  exit 1
fi

"$SCRIPT_DIR/validate-run" "$issue_id" >/dev/null

claim_worktree() {
  local worktree_input
  worktree_input="$(jq -r '.worktree // empty' "$claim_dir/owner.json")"
  validate_claimed_repository "$repository" "$worktree_input" "$issue_id"
}

verification_is_current_and_canonical() {
  local required_tier="${1:-}"
  local worktree head evidence_tier expected_command control_identity control_commit_sha manifest_blob_sha
  worktree="$(claim_worktree)" || return
  require_clean_commit "$worktree" || return
  control_identity="$(control_plane_identity "$repository" "$worktree")" || {
    printf 'release-ticket: harness control plane is not commit-bound\n' >&2
    return 1
  }
  if [[ "$control_identity" != *$'\n'* ]]; then
    printf 'release-ticket: invalid harness control-plane identity\n' >&2
    return 1
  fi
  control_commit_sha="${control_identity%%$'\n'*}"
  manifest_blob_sha="${control_identity#*$'\n'}"
  if [[ -z "$control_commit_sha" || -z "$manifest_blob_sha" || "$manifest_blob_sha" == *$'\n'* ]]; then
    printf 'release-ticket: invalid harness control-plane identity\n' >&2
    return 1
  fi
  head="$(git -C "$worktree" rev-parse HEAD)"
  evidence_tier="$(jq -r '.tier' "$run_dir/verification.json")"
  if [[ -n "$required_tier" && "$evidence_tier" != "$required_tier" ]]; then
    printf 'release-ticket: verification tier must be %s\n' "$required_tier" >&2
    return 1
  fi
  expected_command="$(jq -c --arg repository "$repository" --arg tier "$evidence_tier" \
    '.repositories[$repository].checks[$tier]' "$MANIFEST")"
  if [[ "$expected_command" == "null" ]]; then
    printf 'release-ticket: no canonical command for repository=%s tier=%s\n' "$repository" "$evidence_tier" >&2
    return 1
  fi
  if ! jq -e \
    --arg issue_id "$issue_id" \
    --arg repository "$repository" \
    --arg tier "$evidence_tier" \
    --arg head "$head" \
    --arg control_commit_sha "$control_commit_sha" \
    --arg manifest_blob_sha "$manifest_blob_sha" \
    --argjson expected_command "$expected_command" '
      .issue_id == $issue_id and
      .repository == $repository and
      .tier == $tier and
      .overall == "passed" and
      .commit_sha == $head and
      .control_plane.commit_sha == $control_commit_sha and
      .control_plane.manifest_blob_sha == $manifest_blob_sha and
      .check_command.command == "harness/bin/check" and
      .check_command.arguments == [$repository, $tier, "--record", $issue_id] and
      (.commands | length == 1) and
      ([.commands[0].command] + .commands[0].arguments) == $expected_command and
      .commands[0].commit_sha == $head and
      .commands[0].exit_code == 0 and
      .commands[0].status == "passed"
    ' "$run_dir/verification.json" >/dev/null; then
    printf 'release-ticket: verification is stale, mismatched, or non-canonical\n' >&2
    return 1
  fi
}

implementation_matches_claim() {
  local claim_owner implementer worktree head implementation_commit
  claim_owner="$(jq -r '.owner // empty' "$claim_dir/owner.json")"
  implementer="$(jq -r '.implementer // empty' "$run_dir/implementation.json")"
  implementation_commit="$(jq -r '.commit_sha // empty' "$run_dir/implementation.json")"
  worktree="$(claim_worktree)" || return
  head="$(git -C "$worktree" rev-parse HEAD)"
  if [[ -z "$claim_owner" || "$implementer" != "$claim_owner" || "$implementation_commit" != "$head" ]]; then
    printf 'release-ticket: implementation owner and commit must match the active claim\n' >&2
    return 1
  fi
}

recorded_implementer() {
  local candidate=""
  local owner_file
  shopt -s nullglob
  for owner_file in "$run_dir"/.claim.*.review*/owner.json; do
    candidate="$owner_file"
  done
  shopt -u nullglob
  if [[ -z "$candidate" ]]; then
    printf 'release-ticket: implementation claim history is missing\n' >&2
    return 1
  fi
  jq -r '.owner // empty' "$candidate"
}

review_is_current_and_independent() {
  local expected_verdict="$1"
  local worktree head claim_owner implementer implementation_commit recorded_owner
  worktree="$(claim_worktree)" || return
  head="$(git -C "$worktree" rev-parse HEAD)"
  claim_owner="$(jq -r '.owner // empty' "$claim_dir/owner.json")"
  implementer="$(jq -r '.implementer // empty' "$run_dir/implementation.json")"
  implementation_commit="$(jq -r '.commit_sha // empty' "$run_dir/implementation.json")"
  recorded_owner="$(recorded_implementer)" || return
  if [[ -z "$claim_owner" || -z "$recorded_owner" || "$implementer" != "$recorded_owner" || "$implementation_commit" != "$head" || "$claim_owner" == "$recorded_owner" ]]; then
    printf 'release-ticket: approved review must use a different recorded owner label\n' >&2
    return 1
  fi
  if ! jq -e --arg reviewer "$claim_owner" --arg head "$head" --arg verdict "$expected_verdict" '
    .verdict == $verdict and
    .reviewer == $reviewer and
    .reviewed_commit == $head and
    (.reviewed_at | type == "string" and length > 0)
  ' "$run_dir/review.json" >/dev/null; then
    printf 'release-ticket: review must identify the current reviewer label, verdict, and commit\n' >&2
    return 1
  fi
}

case "$next_status" in
  review)
    if ! jq -e '.status == "implemented"' "$run_dir/implementation.json" >/dev/null ||
       ! implementation_matches_claim ||
       ! verification_is_current_and_canonical full; then
      printf 'release-ticket: review requires implemented handoff and current canonical full verification\n' >&2
      exit 1
    fi
    ;;
  planned)
    review_is_current_and_independent changes_requested || exit 1
    ;;
  blocked)
    review_is_current_and_independent blocked || exit 1
    ;;
  done)
    if ! jq -e '.acceptance_criteria | length > 0' "$run_dir/task.json" >/dev/null ||
       ! jq -e '.status == "implemented"' "$run_dir/implementation.json" >/dev/null ||
       ! verification_is_current_and_canonical full ||
       ! review_is_current_and_independent approved; then
      printf 'release-ticket: done requires acceptance criteria, implementation, current canonical full verification, and reviewer attestation\n' >&2
      exit 1
    fi
    ;;
esac

released_at="$(date -u +%Y%m%dT%H%M%SZ)"
claim_history="$run_dir/.claim.$released_at.$next_status"
claim_suffix=0
while [[ -e "$claim_history" ]]; do
  claim_suffix=$((claim_suffix + 1))
  claim_history="$run_dir/.claim.$released_at.$next_status.$claim_suffix"
done
recover_claim() {
  if [[ -d "$claim_history" && ! -e "$claim_dir" ]] &&
     [[ "$(jq -r '.phase // empty' "$run_dir/workflow.json" 2>/dev/null)" == "$phase" ]]; then
    mv "$claim_history" "$claim_dir"
  fi
}
trap recover_claim EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
mv "$claim_dir" "$claim_history"
actor="$(jq -r '.owner' "$claim_history/owner.json")"
case "$next_status" in
  review)
    workflow_transition "$run_dir" candidate awaiting_review "$actor" release_review '' \
      "$(jq -r '.commit_sha' "$run_dir/implementation.json")"
    ;;
  planned|blocked)
    verdict="$next_status"
    [[ "$next_status" != planned ]] || verdict=changes_requested
    workflow_review_result "$run_dir" "$actor" "$verdict" "$(jq -r '.reviewed_commit' "$run_dir/review.json")"
    ;;
  done)
    workflow_transition "$run_dir" reviewing approved "$actor" approve '' \
      "$(jq -r '.reviewed_commit' "$run_dir/review.json")"
    ;;
esac
trap - EXIT INT TERM
phase="$(jq -r '.phase' "$run_dir/workflow.json")"
printf '# Current\n\n- Owner: unassigned\n- Worktree: unassigned\n- Phase: %s\n- Next action: %s\n- Blockers: %s\n' \
  "$phase" "$(workflow_next_action "$phase")" "$(jq -r '.blocker // "none"' "$run_dir/workflow.json")" > "$run_dir/current.md"
printf 'release-ticket: %s released; phase=%s; claim history preserved\n' "$issue_id" "$phase"
