#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WORKSPACE_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
MANIFEST="$WORKSPACE_ROOT/harness/repos.json"

required_commands=(git jq rg)
required_repositories=(frontend backend blockchain marketMaker)
required_workspace_files=(
  AGENTS.md
  docs/ACTIVE_CONTEXT.md
  docs/v2/V2_OPERATING_CONTEXT.md
  docs/architecture/REPO_MAP.md
  harness/repos.json
  harness/bin/check
  harness/bin/claim-ticket
  harness/bin/context
  harness/bin/release-ticket
  harness/bin/sensitive-check
  harness/bin/start-ticket
  harness/bin/status
  harness/bin/validate-run
)
failed=0

for command_name in "${required_commands[@]}"; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    printf 'doctor: missing required command: %s\n' "$command_name" >&2
    failed=1
  fi
done

for required_file in "${required_workspace_files[@]}"; do
  if [[ ! -e "$WORKSPACE_ROOT/$required_file" ]]; then
    printf 'doctor: missing workspace file: %s\n' "$required_file" >&2
    failed=1
  fi
done

if [[ ! -f "$MANIFEST" ]]; then
  printf 'doctor: missing manifest: %s\n' "$MANIFEST" >&2
  failed=1
elif ! jq -e '.version == 1 and (.repositories | keys | length == 4)' "$MANIFEST" >/dev/null; then
  printf 'doctor: invalid repository manifest\n' >&2
  failed=1
fi

for repository in "${required_repositories[@]}"; do
  repository_path="$WORKSPACE_ROOT/$repository"
  if [[ ! -d "$repository_path" ]]; then
    printf 'doctor: missing repository: %s\n' "$repository" >&2
    failed=1
    continue
  fi
  if [[ ! -f "$repository_path/AGENTS.md" ]]; then
    printf 'doctor: missing repository protocol: %s/AGENTS.md\n' "$repository" >&2
    failed=1
  fi
  if git -C "$repository_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    branch="$(git -C "$repository_path" branch --show-current)"
    dirty_count="$(git -C "$repository_path" status --short | wc -l | tr -d ' ')"
    printf 'doctor: %-12s branch=%-36s dirty_entries=%s\n' "$repository" "${branch:-detached}" "$dirty_count"
  else
    printf 'doctor: %s is not a Git repository\n' "$repository" >&2
    failed=1
  fi
done

for runtime in bun uv forge; do
  if ! command -v "$runtime" >/dev/null 2>&1; then
    printf 'doctor: missing project runtime: %s\n' "$runtime" >&2
    failed=1
  fi
done

if ! "$SCRIPT_DIR/sensitive-check"; then
  failed=1
fi

if (( failed != 0 )); then
  printf 'doctor: FAILED\n' >&2
  exit 1
fi

printf 'doctor: workspace ready\n'
