#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WORKSPACE_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
RUNS_ROOT="${HARNESS_RUNS_ROOT:-$WORKSPACE_ROOT/harness/runs}"
issue_id="${1:-}"
legacy_mode="${2:-}"

if [[ ! "$issue_id" =~ ^[A-Z][A-Z0-9]+-[0-9]+$ || ( -n "$legacy_mode" && "$legacy_mode" != --legacy ) ]]; then
  printf 'usage: %s <ISSUE-ID> [--legacy]\n' "$0" >&2
  exit 2
fi

run_dir="$RUNS_ROOT/$issue_id"
artifacts=(task.json implementation.json review.json verification.json)
[[ "$legacy_mode" == --legacy ]] || artifacts+=(workflow.json)
for artifact in "${artifacts[@]}"; do
  if [[ ! -f "$run_dir/$artifact" ]] || ! jq empty "$run_dir/$artifact"; then
    printf 'validate-run: missing or invalid JSON: %s/%s\n' "$issue_id" "$artifact" >&2
    exit 1
  fi
done

jq -e --arg issue_id "$issue_id" '
  def timestamp: type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$");
  def risk_approval:
    type == "object" and ((keys - ["source","reference"]) | length == 0) and
    (.source | IN("linear","user")) and (.reference | type == "string" and length > 0);
  ((keys - ["issue_id", "objective", "acceptance_criteria", "repositories", "dependencies", "risk_tier", "risk_approval", "status", "created_at"]) | length == 0) and
  .issue_id == $issue_id and
  (.objective | type == "string" and length > 0) and
  (.acceptance_criteria | type == "array" and all(.[]; type == "string" and length > 0)) and
  (.repositories | type == "array" and length == 1) and
  (.repositories[0] | IN("workspace", "frontend", "backend", "blockchain", "marketMaker")) and
  (.dependencies | type == "array" and
    (map([.issue_id,.gate]) | unique | length) == length and
    all(.[];
      type == "object" and ((keys - ["issue_id","gate"]) | length == 0) and
      (.issue_id | type == "string" and test("^[A-Z][A-Z0-9]+-[0-9]+$") and . != $issue_id) and
      (.gate | IN("contract_approved","fixture_pinned","pr_ready","merged")))) and
  ((.risk_tier // "high") | IN("low","standard","high")) and
  (if ((.risk_tier // "high") | IN("low","standard")) then
    (.risk_approval | risk_approval)
   else
    ((.risk_approval // null) == null or (.risk_approval | risk_approval))
   end) and
  (.created_at | timestamp) and
  (.status | IN("planned", "in_progress", "review", "blocked", "done"))
' "$run_dir/task.json" >/dev/null || {
  printf 'validate-run: invalid task packet: %s\n' "$issue_id" >&2
  exit 1
}

if [[ -f "$run_dir/milestones.json" ]]; then
  jq -e --arg issue_id "$issue_id" --arg implementer "$(jq -r '.implementer // empty' "$run_dir/implementation.json")" \
    --arg reviewer "$(jq -r 'select(.verdict == "approved") | .reviewer' "$run_dir/review.json")" '
    def timestamp: type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$");
    .issue_id == $issue_id and (.milestones | type == "array") and
    (.milestones | map(.gate) | unique | length) == (.milestones | length) and
    all(.milestones[];
      ((keys - ["gate","repository","source_commit","artifact","algorithm","digest","proposer","proposed_at","status","approver","approved_at","pr_number","base_branch","merge_commit"]) | length == 0) and
      (.gate | IN("contract_approved","fixture_pinned","pr_ready","merged")) and
      (.repository | IN("workspace","frontend","backend","blockchain","marketMaker")) and
      (.source_commit | test("^[0-9a-f]{40,64}$")) and (.artifact | type == "string" and length > 0) and
      .algorithm == "sha256" and (.digest | test("^[0-9a-f]{64}$")) and
      .proposer == $implementer and (.proposed_at | timestamp) and
      (if .status == "candidate" then (has("approver") | not) and (has("approved_at") | not)
       elif .status == "approved" then .approver == $reviewer and
         .approver != .proposer and .approver != $implementer and (.approved_at | timestamp)
       else false end))
  ' "$run_dir/milestones.json" >/dev/null || {
    printf 'validate-run: invalid milestones\n' >&2
    exit 1
  }
  if jq -e 'any(.milestones[]; .status == "approved")' "$run_dir/milestones.json" >/dev/null; then
    commit="$(jq -r '.commit_sha // empty' "$run_dir/implementation.json")"
    reviewer="$(jq -r 'select(.verdict == "approved") | .reviewer' "$run_dir/review.json")"
    jq -e --arg commit "$commit" --arg reviewer "$reviewer" '
      .phase == "approved" and .last_evidence_commit == $commit and
      .history[-1].action == "approve" and .history[-1].actor == $reviewer
    ' "$run_dir/workflow.json" >/dev/null || {
      printf 'validate-run: approved milestone lacks released review\n' >&2
      exit 1
    }
  fi
fi

if [[ "$legacy_mode" != --legacy ]]; then
  jq -e --arg issue_id "$issue_id" --arg risk_tier "$(jq -r '.risk_tier // "high"' "$run_dir/task.json")" '
    def timestamp: type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$");
    def edge($from;$to;$action):
      ($from == "planned" and $to == "implementing" and $action == "claim_implementation") or
      ($from == "repair" and $to == "implementing" and $action == "claim_repair") or
      ($from == "implementing" and $to == "candidate" and $action == "record_implementation") or
      ($from == "candidate" and $to == "awaiting_review" and $action == "release_review") or
      ($from == "candidate" and $to == "approved" and $action == "approve_low_risk") or
      ($from == "awaiting_review" and $to == "reviewing" and $action == "claim_review") or
      ($from == "reviewing" and $to == "repair" and ($action == "changes_requested" or $action == "review_blocked")) or
      ($from == "reviewing" and $to == "human_blocked" and $action == "repair_budget_exhausted") or
      ($from == "reviewing" and $to == "approved" and $action == "approve");
    .issue_id == $issue_id and .max_repairs == 2 and
    (.phase | IN("planned","implementing","candidate","awaiting_review","reviewing","repair","human_blocked","approved")) and
    (.repair_count | type == "number" and floor == . and . >= 0 and . <= 2) and
    (.blocker == null or (.blocker | type == "string" and length > 0)) and
    (.last_evidence_commit == null or (.last_evidence_commit | test("^[0-9a-f]{40,64}$"))) and
    (.next_action | type == "string" and length > 0) and
    (.history | type == "array" and length > 0) and
    (.history[0] | (.from == null) and (.at | timestamp) and
      ((.action == "start" and .to == "planned") or (.action == "migrate"))) and
    (all(.history[]; (.actor | type == "string" and length > 0) and (.at | timestamp))) and
    (all(.history[];
      if .action == "approve_low_risk" then $risk_tier == "low"
      elif (.action | IN("release_review","claim_review","changes_requested","review_blocked","repair_budget_exhausted","approve")) then $risk_tier != "low"
      else true end)) and
    (. as $w | all(range(1; $w.history|length); . as $i |
      $w.history[$i].from == $w.history[$i-1].to and
      edge($w.history[$i].from;$w.history[$i].to;$w.history[$i].action))) and
    .phase == .history[-1].to
  ' "$run_dir/workflow.json" >/dev/null || {
    printf 'validate-run: invalid workflow\n' >&2
    exit 1
  }
  # workflow.json is authoritative; task.status is a best-effort compatibility projection.
fi

repository="$(jq -r '.repositories[0]' "$run_dir/task.json")"
for artifact in implementation.json review.json verification.json; do
  jq -e --arg issue_id "$issue_id" --arg repository "$repository" \
    '.issue_id == $issue_id and .repository == $repository' "$run_dir/$artifact" >/dev/null || {
      printf 'validate-run: %s does not match task identity\n' "$artifact" >&2
      exit 1
    }
done

jq -e '
  def timestamp: type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$");
  ((keys - ["issue_id", "repository", "status", "summary", "files_changed", "known_issues", "implementer", "commit_sha", "recorded_at"]) | length == 0) and
  (.status | IN("pending", "implemented", "blocked")) and
  (.summary | type == "string") and
  (.files_changed | type == "array" and all(.[]; type == "string")) and
  (.known_issues | type == "array" and all(.[]; type == "string")) and
  (if .status == "implemented" then
    (.implementer | type == "string" and length > 0) and
    (.commit_sha | type == "string" and test("^[0-9a-f]{40,64}$")) and
    (.recorded_at | timestamp)
   else true end)
' "$run_dir/implementation.json" >/dev/null || {
  printf 'validate-run: invalid implementation evidence\n' >&2
  exit 1
}

jq -e '
  def timestamp: type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$");
  ((keys - ["issue_id", "repository", "verdict", "reviewer", "reviewed_commit", "reviewed_at", "findings"]) | length == 0) and
  (.verdict | IN("pending", "approved", "changes_requested", "blocked")) and
  (.findings | type == "array" and all(.[];
    type == "object" and
    ((keys - ["severity", "summary", "regression_test"]) | length == 0) and
    (.severity | IN("critical", "high", "medium", "low")) and
    (.summary | type == "string" and length > 0) and
    ((has("regression_test") | not) or (.regression_test | type == "string"))
  )) and
  (if .verdict == "pending" then true else
    (.reviewer | type == "string" and length > 0) and
    (.reviewed_commit | type == "string" and test("^[0-9a-f]{40,64}$")) and
    (.reviewed_at | timestamp)
  end)
' "$run_dir/review.json" >/dev/null || {
  printf 'validate-run: invalid review evidence\n' >&2
  exit 1
}

jq -e --arg issue_id "$issue_id" --arg repository "$repository" '
  def sha: type == "string" and test("^[0-9a-f]{40,64}$");
  def timestamp: type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$");
  def duration: type == "number" and floor == . and . >= 0;
  ((keys - ["issue_id", "repository", "tier", "commit_sha", "started_at", "ended_at", "duration_seconds", "control_plane", "check_command", "overall", "commands"]) | length == 0) and
  (.control_plane? | if . == null then true else ((keys - ["commit_sha", "manifest_blob_sha"]) | length == 0) end) and
  (.check_command? | if . == null then true else ((keys - ["command", "arguments"]) | length == 0) end) and
  (.commands | type == "array" and all(.[]; ((keys - ["command", "arguments", "started_at", "ended_at", "duration_seconds", "commit_sha", "exit_code", "status"]) | length == 0))) and
  (.commit_sha // "") as $commit_sha |
  (.tier | IN("fast", "full")) and
  (.overall | IN("pending", "passed", "failed", "blocked")) and
  (.commands | type == "array") and
  (if (.overall | IN("passed", "failed")) then
    (.commit_sha | sha) and
    (.started_at | timestamp) and
    (.ended_at | timestamp) and
    (.duration_seconds | duration) and
    (.control_plane.commit_sha | sha) and
    (.control_plane.manifest_blob_sha | sha) and
    (.check_command.command == "harness/bin/check") and
    (.check_command.arguments == [$repository, .tier, "--record", $issue_id]) and
    (.commands | length > 0) and
    (all(.commands[];
      (.command | type == "string" and length > 0) and
      (.arguments | type == "array" and all(.[]; type == "string")) and
      (.started_at | timestamp) and
      (.ended_at | timestamp) and
      (.duration_seconds | duration) and
      (.commit_sha | sha) and
      .commit_sha == $commit_sha and
      (.exit_code | type == "number" and floor == .) and
      (.status | IN("passed", "failed")) and
      ((.status == "passed" and .exit_code == 0) or
       (.status == "failed" and .exit_code != 0))
    )) and
    ((.overall == "passed" and all(.commands[]; .status == "passed" and .exit_code == 0)) or
     (.overall == "failed" and any(.commands[]; .status == "failed" and .exit_code != 0)))
  else
    (.commands | length == 0)
  end)
' "$run_dir/verification.json" >/dev/null || {
  printf 'validate-run: invalid or non-derived verification evidence\n' >&2
  exit 1
}

if [[ "$legacy_mode" != --legacy && "$(jq -r '.phase' "$run_dir/workflow.json")" == approved ]]; then
  risk_tier="$(jq -r '.risk_tier // "high"' "$run_dir/task.json")"
  required_tier=fast
  [[ "$risk_tier" != high ]] || required_tier=full
  if ! jq -e --arg tier "$required_tier" '.overall == "passed" and .tier == $tier' \
    "$run_dir/verification.json" >/dev/null; then
    printf 'validate-run: approved run lacks risk-required verification\n' >&2
    exit 1
  fi
  if [[ "$risk_tier" == low ]]; then
    jq -e '.verdict == "pending"' "$run_dir/review.json" >/dev/null || {
      printf 'validate-run: low-risk approval cannot contain a reviewer verdict\n' >&2
      exit 1
    }
  else
    jq -e '.verdict == "approved"' "$run_dir/review.json" >/dev/null || {
      printf 'validate-run: standard/high-risk approval requires reviewer approval\n' >&2
      exit 1
    }
  fi
fi

printf 'validate-run: %s passed\n' "$issue_id"
