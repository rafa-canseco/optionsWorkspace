#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WORKSPACE_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
RUNS_ROOT="${HARNESS_RUNS_ROOT:-$WORKSPACE_ROOT/harness/runs}"
# shellcheck source=../lib/workflow.sh
source "$WORKSPACE_ROOT/harness/lib/workflow.sh"

printf '%-12s %-16s %-9s %-12s %-16s %-24s %s\n' ISSUE PHASE REPAIRS STATUS OWNER BLOCKER NEXT
shopt -s nullglob
for task_file in "$RUNS_ROOT"/*/task.json; do
  run_dir="$(dirname -- "$task_file")"
  issue_id="$(basename -- "$run_dir")"
  owner='-'
  if [[ -f "$run_dir/.claim/owner.json" ]]; then
    owner="$(jq -er '.owner | select(type == "string" and length > 0)' "$run_dir/.claim/owner.json" 2>/dev/null)" || owner=invalid
  fi
  if [[ -f "$run_dir/workflow.json" ]]; then
    if ! "$SCRIPT_DIR/validate-run" "$issue_id" >/dev/null 2>&1; then
      status="$(jq -r '.status // "invalid"' "$task_file" 2>/dev/null)" || status=invalid
      printf '%-12s %-16s %-9s %-12s %-16s %-24s %s\n' \
        "$issue_id" invalid - "$status" "$owner" invalid inspect_run
      continue
    fi
    phase="$(jq -r '.phase' "$run_dir/workflow.json")"
    repairs="$(jq -r '"\(.repair_count)/\(.max_repairs)"' "$run_dir/workflow.json")"
    status="$(workflow_task_status "$phase")"
    blocker="$(jq -r '.blocker // "none"' "$run_dir/workflow.json")"
    next="$(jq -r '.next_action' "$run_dir/workflow.json")"
  else
    if ! status="$(jq -er '.status | select(type == "string")' "$task_file" 2>/dev/null)"; then
      printf '%-12s %-16s %-9s %-12s %-16s %-24s %s\n' \
        "$issue_id" invalid - invalid "$owner" invalid inspect_run
      continue
    fi
    repairs='-'
    blocker=none
    if [[ "$status" == done ]]; then phase=historical; next=complete
    else phase=legacy; next=migration_required
    fi
  fi
  printf '%-12s %-16s %-9s %-12s %-16s %-24s %s\n' \
    "$issue_id" "$phase" "$repairs" "$status" "$owner" "$blocker" "$next"
done
