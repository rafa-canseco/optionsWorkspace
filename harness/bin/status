#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WORKSPACE_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
RUNS_ROOT="${HARNESS_RUNS_ROOT:-$WORKSPACE_ROOT/harness/runs}"

printf '%-14s %-14s %-16s %s\n' ISSUE STATUS OWNER WORKTREE

shopt -s nullglob
for task_file in "$RUNS_ROOT"/*/task.json; do
  run_dir="$(dirname -- "$task_file")"
  issue_id="$(jq -r '.issue_id' "$task_file")"
  task_status="$(jq -r '.status' "$task_file")"
  owner='-'
  worktree='-'
  if [[ -f "$run_dir/.claim/owner.json" ]]; then
    owner="$(jq -r '.owner' "$run_dir/.claim/owner.json")"
    worktree="$(jq -r '.worktree' "$run_dir/.claim/owner.json")"
  fi
  printf '%-14s %-14s %-16s %s\n' "$issue_id" "$task_status" "$owner" "$worktree"
done
