#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WORKSPACE_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
MANIFEST="$WORKSPACE_ROOT/harness/repos.json"
RUNS_ROOT="${HARNESS_RUNS_ROOT:-$WORKSPACE_ROOT/harness/runs}"
# shellcheck source=../lib/dependencies.sh
source "$WORKSPACE_ROOT/harness/lib/dependencies.sh"
action="${1:-}"
issue_id="${2:-}"
gate="${3:-}"
artifact="${4:-}"

if [[ ! "$issue_id" =~ ^[A-Z][A-Z0-9]+-[0-9]+$ ]] || ! dependency_gate_valid "$gate"; then
  printf 'usage: %s <propose|approve> <ISSUE-ID> <contract_approved|fixture_pinned|pr_ready|merged> [artifact-or-pr-url]\n' "$0" >&2
  exit 2
fi
run_dir="$RUNS_ROOT/$issue_id"
repository="$(jq -r '.repositories[0]' "$run_dir/task.json")"
commit="$(jq -r 'select(.status == "implemented") | .commit_sha' "$run_dir/implementation.json")"
implementer="$(jq -r '.implementer' "$run_dir/implementation.json")"
[[ -n "$commit" ]] || { printf 'record-milestone: implemented source commit required\n' >&2; exit 1; }
now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
file="$run_dir/milestones.json"
[[ -f "$file" ]] || jq -n --arg issue_id "$issue_id" '{issue_id:$issue_id,milestones:[]}' > "$file"

case "$action" in
  propose)
    [[ -n "$artifact" ]] || { printf 'record-milestone: artifact path or PR URL required\n' >&2; exit 2; }
    jq -e --arg gate "$gate" 'all(.milestones[]; .gate != $gate)' "$file" >/dev/null || {
      printf 'record-milestone: gate already recorded: %s\n' "$gate" >&2
      exit 1
    }
    evidence="$(dependency_evidence "$repository" "$commit" "$gate" "$artifact")" || {
      printf 'record-milestone: evidence is unavailable or mismatched\n' >&2
      exit 1
    }
    tmp="$file.tmp"
    jq --arg gate "$gate" --arg repository "$repository" --arg commit "$commit" \
      --arg artifact "$artifact" --arg actor "$implementer" --arg now "$now" --argjson evidence "$evidence" '
      .milestones += [({gate:$gate,repository:$repository,source_commit:$commit,artifact:$artifact,
        algorithm:"sha256",digest:$evidence.digest,proposer:$actor,proposed_at:$now,status:"candidate"}
        + ($evidence | del(.digest)))]
    ' "$file" > "$tmp" && mv "$tmp" "$file"
    actor="$implementer"
    ;;
  approve)
    [[ -z "$artifact" ]] || { printf 'record-milestone: approve does not accept an artifact\n' >&2; exit 2; }
    candidate="$(jq -c --arg gate "$gate" '.milestones[] | select(.gate == $gate and .status == "candidate")' "$file")"
    [[ -n "$candidate" ]] || { printf 'record-milestone: candidate required\n' >&2; exit 1; }
    actor="$(jq -r --arg commit "$commit" 'select(.verdict == "approved" and .reviewed_commit == $commit) | .reviewer' "$run_dir/review.json")"
    if [[ -z "$actor" || "$actor" == "$implementer" ]] ||
       ! jq -e --arg commit "$commit" --arg actor "$actor" '
         .phase == "approved" and .last_evidence_commit == $commit and
         .history[-1].action == "approve" and .history[-1].actor == $actor
       ' "$run_dir/workflow.json" >/dev/null; then
      printf 'record-milestone: successfully released independent review required\n' >&2
      exit 1
    fi
    evidence="$(dependency_evidence "$repository" "$commit" "$gate" "$(jq -r '.artifact' <<<"$candidate")")" || {
      printf 'record-milestone: evidence became stale\n' >&2
      exit 1
    }
    jq -e --argjson evidence "$evidence" '.digest == $evidence.digest and
      ((.pr_number // null) == ($evidence.pr_number // null)) and
      ((.base_branch // null) == ($evidence.base_branch // null)) and
      ((.merge_commit // null) == ($evidence.merge_commit // null))' <<<"$candidate" >/dev/null || {
      printf 'record-milestone: evidence changed since proposal\n' >&2
      exit 1
    }
    tmp="$file.tmp"
    jq --arg gate "$gate" --arg actor "$actor" --arg now "$now" '
      .milestones |= map(if .gate == $gate then . + {status:"approved",approver:$actor,approved_at:$now} else . end)
    ' "$file" > "$tmp" && mv "$tmp" "$file"
    ;;
  *) printf 'record-milestone: action must be propose or approve\n' >&2; exit 2 ;;
esac
printf 'record-milestone: %s %s %s by %s\n' "$issue_id" "$gate" "$action" "$actor"
