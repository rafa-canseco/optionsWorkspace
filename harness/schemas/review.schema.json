{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness independent review",
  "type": "object",
  "additionalProperties": false,
  "required": ["issue_id", "repository", "verdict", "findings"],
  "properties": {
    "issue_id": { "type": "string" },
    "repository": { "enum": ["workspace", "frontend", "backend", "blockchain", "marketMaker"] },
    "verdict": { "enum": ["pending", "approved", "changes_requested", "blocked"] },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewed_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "summary"],
        "properties": {
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "summary": { "type": "string", "minLength": 1 },
          "regression_test": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "not": { "const": "pending" } } }, "required": ["verdict"] },
      "then": { "required": ["reviewer", "reviewed_commit", "reviewed_at"] }
    }
  ]
}
