{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b1nary.app/schemas/harness-task.json",
  "title": "Harness task packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_id",
    "objective",
    "acceptance_criteria",
    "repositories",
    "status",
    "created_at"
  ],
  "properties": {
    "issue_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" },
    "objective": { "type": "string", "minLength": 1 },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["workspace", "frontend", "backend", "blockchain", "marketMaker"] }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_id", "gate"],
        "properties": {
          "issue_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" },
          "gate": { "enum": ["contract_approved", "fixture_pinned", "pr_ready", "merged"] }
        }
      },
      "default": []
    },
    "status": {
      "enum": ["planned", "in_progress", "review", "blocked", "done"]
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
