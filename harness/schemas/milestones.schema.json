{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b1nary.app/schemas/harness-milestones.json",
  "title": "Harness dependency milestones",
  "type": "object",
  "additionalProperties": false,
  "required": ["issue_id", "milestones"],
  "properties": {
    "issue_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "repository", "source_commit", "artifact", "algorithm", "digest", "proposer", "proposed_at", "status"],
        "properties": {
          "gate": { "enum": ["contract_approved", "fixture_pinned", "pr_ready", "merged"] },
          "repository": { "enum": ["workspace", "frontend", "backend", "blockchain", "marketMaker"] },
          "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
          "artifact": { "type": "string", "minLength": 1 },
          "algorithm": { "const": "sha256" },
          "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "proposer": { "type": "string", "minLength": 1 },
          "proposed_at": { "type": "string", "format": "date-time" },
          "status": { "enum": ["candidate", "approved"] },
          "approver": { "type": "string", "minLength": 1 },
          "approved_at": { "type": "string", "format": "date-time" },
          "pr_number": { "type": "integer", "minimum": 1 },
          "base_branch": { "type": "string", "minLength": 1 },
          "merge_commit": { "type": ["string", "null"] }
        }
      }
    }
  }
}
