{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness verification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["issue_id", "repository", "tier", "overall", "commands"],
  "properties": {
    "issue_id": { "type": "string" },
    "repository": { "enum": ["frontend", "backend", "blockchain", "marketMaker"] },
    "tier": { "enum": ["fast", "full"] },
    "overall": { "enum": ["pending", "passed", "failed", "blocked"] },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status"],
        "properties": {
          "command": { "type": "string" },
          "status": { "enum": ["pending", "passed", "failed", "blocked"] },
          "exit_code": { "type": "integer" },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
